      "payload": {
        "scenario_description": "kohls",
        "memory_description": "Kohls website has non-static clearance section navigation and unpredictable filter application order, leading to failed clearance filtering.",
        "content_body": "On Kohls.com, the clearance section is not consistently accessible via a fixed navigation link or button, and the order in which filters (such as category and size) are applied can vary dynamically. This makes it unreliable to assume a specific path or sequence for reaching the clearance section and applying filters like 'women's dresses' and 'size small.' Users must manually locate the clearance section and reapply filters in a specific order, which may not be intuitive or consistent across sessions."
      }
    },
