      "payload": {
        "scenario_description": "jetblue",
        "memory_description": "JetBlue website has dynamic UI elements and inconsistent interaction patterns that lead to task failure.",
        "content_body": "On JetBlue's website, UI layout pitfalls include unexpected placement of form fields and dynamic element IDs that change between page loads, making it difficult to reliably select the correct elements. Additionally, website interaction traps involve non-intuitive navigation flows, such as requiring users to click on hidden or non-obvious elements (e.g., dropdowns or modals) before being able to proceed with flight selection or checkout. For example, the origin city field may not be directly editable, requiring a click on a search box or dropdown first, and business class options may be buried under additional filters or require toggling a separate 'class' selection menu."
      }
    },
