      "payload": {
        "scenario_description": "delta",
        "memory_description": "Delta Airlines website: UI layout inconsistencies and unclear interaction expectations caused task failure.",
        "content_body": "On Delta's website, UI layout pitfalls included unexpected placement of input fields, such as the 'Confirmation Number' field being a clickable element rather than a text input, which led to incorrect selection. Additionally, website interaction traps involved misidentifying input fields (e.g., attempting to type into a non-editable element), requiring users to click on the correct field first before typing. The correct interaction is to click on the 'Confirmation Number' field to activate it, then type the confirmation code, followed by entering the first and last name into their respective fields and clicking 'Search' to find the trip."
      }
    },
