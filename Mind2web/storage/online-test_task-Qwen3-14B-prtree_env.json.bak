      "payload": {
        "scenario_description": "seatgeek",
        "memory_description": "SeatGeek website has inconsistent UI layout and ambiguous interaction elements that hinder task completion.",
        "content_body": "On SeatGeek, UI layout pitfalls include unexpected placement of location input fields and inconsistent element IDs across pages, making it difficult to locate the correct input for city selection. Additionally, website interaction traps involve incorrect typing of location names (e.g., typing 'New York City' instead of 'New York') and clicking on non-target elements due to similar-looking buttons or dynamically generated IDs. Correct interaction requires typing the exact city name as expected by the system and carefully selecting the correct search or filter button to avoid misalignment with the target element."
      }
