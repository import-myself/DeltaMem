      "payload": {
        "scenario_description": "delta",
        "memory_description": "The website requires explicit selection of 'Miles' or 'Award' travel type via a specific toggle or filter option, not through default search behavior.",
        "content_body": "On Delta Airlines' website, when searching for flights that can be purchased with miles, users must explicitly select the 'Award' or 'Miles' travel type using a toggle, filter, or checkbox option. This selection is not automatically applied during the flight search process and must be manually activated in a dedicated section of the booking interface. Simply entering the departure and arrival cities and date will not filter results to only those available with miles; the 'Award' or 'Miles' filter must be explicitly chosen for the search to return the correct results."
      }
    },
