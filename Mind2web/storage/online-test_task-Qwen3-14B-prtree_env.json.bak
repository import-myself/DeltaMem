      "payload": {
        "scenario_description": "soundcloud",
        "memory_description": "Filtering by a tag on SoundCloud requires an explicit search or navigation step that is not automatically triggered by typing the tag into a field.",
        "content_body": "On SoundCloud, when attempting to filter trending playlists by a specific tag like #Electronics, simply typing the tag into a text field does not automatically apply the filter. Instead, the user must explicitly navigate to a section or use a dedicated search/filter interface to apply the tag. This behavior is not intuitive and differs from general website conventions where typing a tag might be sufficient to trigger a filter. Additionally, the target elements for playlist navigation or playback may not be immediately available in the DOM due to dynamic loading, requiring delays or rechecks for element presence before interaction."
      }
    },
