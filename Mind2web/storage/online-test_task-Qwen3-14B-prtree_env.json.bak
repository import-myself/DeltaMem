      "payload": {
        "scenario_description": "yelp",
        "memory_description": "Yelp's search filters for pricing and availability are not consistently accessible via static HTML elements, leading to missed interaction steps.",
        "content_body": "On Yelp, when searching for restaurants with specific criteria like pricing ($$) and availability ('open now'), these filters are often not present in the static HTML and are instead dynamically loaded or hidden until after the initial search. This means that attempting to click or type into these elements before they are rendered will fail. To succeed, ensure that these filters are fully loaded and visible in the DOM before interacting with them, and account for the possibility that they may be nested within collapsible sections or require additional user actions (like clicking a 'More Filters' button) to become accessible."
      }
    },
