      "payload": {
        "scenario_description": "flightaware",
        "memory_description": "FlightAware's contact form fields have dynamic naming conventions that change based on the context of the form submission, leading to incorrect value targeting.",
        "content_body": "On FlightAware, when filling out a contact form, the input fields (such as name, email, phone, and message) are assigned dynamic IDs or names that vary depending on the form's context or page state. This makes it difficult to reliably target specific fields using static identifiers. Instead of relying on numerical or static text-based IDs, it is better to use consistent labels or XPath expressions that reference the form's structure and the associated label text. For example, using the label text 'Name' to locate the corresponding input field ensures accuracy even when the field's ID changes dynamically."
      }
    },
