      "payload": {
        "scenario_description": "flightaware",
        "memory_description": "FlightAware's origin/destination input fields use dynamic placeholder text that changes based on user input, leading to incorrect field targeting.",
        "content_body": "On FlightAware, when searching for flights between two locations, the origin and destination input fields dynamically update their placeholder text based on user input or previous selections. This can cause automation to incorrectly identify or interact with the wrong field if it relies on static placeholder text or assumes a fixed field structure. To ensure correct interaction, use label text or relative positioning (e.g., 'From' and 'To' labels) to locate the correct input fields, rather than relying on placeholder text or static IDs, which may change dynamically."
      }
    },
