      "payload": {
        "scenario_description": "booking",
        "memory_description": "Booking.com's flight search interface dynamically reassigns input fields for departure and arrival cities, leading to incorrect element selection during user input.",
        "content_body": "On Booking.com, when booking flights, the input fields for departure and arrival cities are not static. The system may swap their positions dynamically based on context or user interaction, which can lead to incorrect city entries if the user assumes a fixed layout. For example, a field labeled 'From' may unexpectedly become 'To' after a previous selection or page load, requiring users to carefully verify the labels before entering city names to avoid booking errors."
      }
    },
