      "payload": {
        "scenario_description": "delta",
        "memory_description": "The website requires exact city names without state abbreviations or additional qualifiers for successful search input.",
        "content_body": "On Delta Airlines' website, when searching for flight destinations, users must input the city name exactly as expected by the system. For example, when searching for Columbus, the correct input is simply 'Columbus' rather than 'Columbus, Ohio' or other variations. Using additional qualifiers like state names or extra text may cause the search to fail or return incorrect results."
      }
